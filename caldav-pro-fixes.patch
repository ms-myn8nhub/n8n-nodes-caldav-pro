diff --git a/test/parameterFallbacks.test.ts b/test/parameterFallbacks.test.ts
new file mode 100644
index 0000000..6e32b1d
--- /dev/null
+++ b/test/parameterFallbacks.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it, vi } from 'vitest';
+import { CalDav } from '../nodes/CalDav/CalDav.node';
+
+/**
+ * A parameter that is not *displayed* for the current resource/operation is
+ * absent from the parameters n8n resolves for an execution, so reading it
+ * without a fallback throws "Could not get parameter". That is not a corner
+ * case: it is the shape the node takes the moment Operation is driven by an
+ * expression, which is how the node has to be wired for an AI Agent.
+ *
+ * These tests execute the node with a context that returns the fallback for
+ * anything the caller did not set, exactly as n8n does.
+ */
+
+const SERVER = 'https://dav.example.com/';
+const WORK = 'https://dav.example.com/calendars/bob/work/';
+
+function makeContext(params: Record<string, unknown>, putStatus = 201) {
+	const requests: Array<{ method: string; url: string; body?: string }> = [];
+	const httpRequestWithAuthentication = vi.fn(async (_cred: string, o: any) => {
+		requests.push({ method: o.method, url: o.url, body: String(o.body ?? '') });
+		if (o.method === 'REPORT') {
+			return { statusCode: 207, headers: {}, body: '<?xml version="1.0"?><d:multistatus xmlns:d="DAV:"/>' };
+		}
+		if (o.method === 'PUT') {
+			return { statusCode: putStatus, headers: { etag: '"w1"' }, body: '' };
+		}
+		throw new Error(`unexpected ${o.method} ${o.url}`);
+	});
+	return {
+		requests,
+		getInputData: () => [{ json: {} }],
+		getNode: () => ({ name: 'CalDAV', type: 'calDav', typeVersion: 1, id: 'n1' }),
+		getTimezone: () => 'Europe/Berlin',
+		getCredentials: async () => ({ serverUrl: SERVER, username: 'bob', password: 'p' }),
+		getNodeParameter: (name: string, _i: number, fallback?: unknown) =>
+			name in params ? params[name] : fallback,
+		continueOnFail: () => false,
+		logger: { debug: vi.fn() },
+		helpers: { httpRequestWithAuthentication },
+	};
+}
+
+describe('hidden parameters fall back instead of throwing', () => {
+	it('Get Many still queries a window when Time Min / Time Max are not displayed', async () => {
+		const ctx = makeContext({ resource: 'event', operation: 'getAll', calendar: WORK });
+		const [items] = await new CalDav().execute.call(ctx as any);
+		expect(items).toEqual([]);
+		const report = ctx.requests.find((r) => r.method === 'REPORT');
+		expect(report?.url).toBe(WORK);
+		// A real, non-empty window reached the server rather than "NaNNaNNaN".
+		expect(report?.body).toMatch(/<c:time-range start="\d{8}T\d{6}Z" end="\d{8}T\d{6}Z"\/>/);
+	});
+
+	it('Search without a displayed Query returns the window rather than failing', async () => {
+		const ctx = makeContext({ resource: 'event', operation: 'search', calendar: WORK });
+		const [items] = await new CalDav().execute.call(ctx as any);
+		expect(items).toEqual([]);
+	});
+});
+
+describe('create with a UID that already exists', () => {
+	it('names the collision instead of passing a bare 412 through', async () => {
+		const ctx = makeContext(
+			{
+				resource: 'event',
+				operation: 'create',
+				calendar: WORK,
+				summary: 'Lunch',
+				start: '2026-04-20T12:00:00+02:00',
+				end: '2026-04-20T13:00:00+02:00',
+				additionalFields: { uid: 'already-there' },
+			},
+			412,
+		);
+		await expect(new CalDav().execute.call(ctx as any)).rejects.toThrow(
+			/UID "already-there" already exists/,
+		);
+	});
+});
